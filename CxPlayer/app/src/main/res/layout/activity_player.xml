<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:show_buffering="when_playing"
        app:surface_type="texture_view"
        app:use_controller="false" />

    <LinearLayout
        android:id="@+id/playerGestureOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_player_gesture_overlay"
        android:clickable="false"
        android:focusable="false"
        android:gravity="center"
        android:minWidth="@dimen/player_gesture_overlay_min_width"
        android:orientation="vertical"
        android:paddingStart="@dimen/player_gesture_overlay_padding_horizontal"
        android:paddingTop="@dimen/player_gesture_overlay_padding_vertical"
        android:paddingEnd="@dimen/player_gesture_overlay_padding_horizontal"
        android:paddingBottom="@dimen/player_gesture_overlay_padding_vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/playerGestureOverlayCueView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="@dimen/player_gesture_overlay_cue_text_size" />

        <TextView
            android:id="@+id/playerGestureOverlayValueView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/player_gesture_overlay_spacing"
            android:textColor="@android:color/white"
            android:textSize="@dimen/player_gesture_overlay_value_text_size"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/playerTopChrome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_player_chrome_scrim"
        android:orientation="vertical"
        android:paddingStart="@dimen/player_chrome_horizontal_padding"
        android:paddingTop="@dimen/player_top_chrome_vertical_padding"
        android:paddingEnd="@dimen/player_chrome_horizontal_padding"
        android:paddingBottom="@dimen/player_bottom_chrome_top_padding">

        <LinearLayout
            android:id="@+id/playerTopRegion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="@dimen/player_top_region_min_height"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/playerBackButton"
                android:layout_width="@dimen/player_transport_button_size"
                android:layout_height="@dimen/player_transport_button_size"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_back_content_description"
                android:padding="@dimen/player_transport_button_padding"
                app:srcCompat="@drawable/ic_player_back" />

            <TextView
                android:id="@+id/playerTitleView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/player_transport_button_spacing"
                android:layout_marginEnd="@dimen/player_transport_button_spacing"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/player_title_fallback"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/playerAiSubtitleButton"
                android:layout_width="@dimen/player_transport_button_size"
                android:layout_height="@dimen/player_transport_button_size"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_ai_subtitle_content_description"
                android:padding="@dimen/player_transport_button_padding"
                android:src="@android:drawable/ic_btn_speak_now"
                android:alpha="0.7" />

            <ImageButton
                android:id="@+id/playerOverflowButton"
                android:layout_width="@dimen/player_transport_button_size"
                android:layout_height="@dimen/player_transport_button_size"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_overflow_content_description"
                android:padding="@dimen/player_transport_button_padding"
                app:srcCompat="@drawable/ic_player_overflow" />
        </LinearLayout>
    </LinearLayout>

    <!-- AI Subtitle Overlay -->
    <LinearLayout
        android:id="@+id/aiSubtitleOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="120dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/aiSubtitleOriginalText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#99000000"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:maxLines="3"
            android:gravity="center" />

        <TextView
            android:id="@+id/aiSubtitleTranslationText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="#99000000"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:textColor="#FFD700"
            android:textSize="14sp"
            android:maxLines="3"
            android:gravity="center" />

        <TextView
            android:id="@+id/aiSubtitleStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="#66000000"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/playerBottomChrome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_player_chrome_scrim"
        android:orientation="vertical"
        android:paddingStart="@dimen/player_chrome_horizontal_padding"
        android:paddingTop="@dimen/player_bottom_chrome_top_padding"
        android:paddingEnd="@dimen/player_chrome_horizontal_padding"
        android:paddingBottom="@dimen/player_bottom_chrome_bottom_padding">

        <LinearLayout
            android:id="@+id/playerTimelineRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="@dimen/player_timeline_row_min_height"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/playerCurrentTimeView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/player_time_label_spacing"
                android:gravity="center"
                android:minWidth="@dimen/player_time_label_min_width"
                android:text="@string/player_time_placeholder"
                android:textColor="@android:color/white"
                android:textSize="@dimen/player_time_text_size" />

            <SeekBar
                android:id="@+id/playerSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:enabled="false"
                android:max="1000"
                android:progress="0"
                android:progressTint="@android:color/white"
                android:splitTrack="false"
                android:thumbTint="@android:color/white" />

            <TextView
                android:id="@+id/playerDurationView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/player_time_label_spacing"
                android:gravity="center"
                android:minWidth="@dimen/player_time_label_min_width"
                android:text="@string/player_time_placeholder"
                android:textColor="@android:color/white"
                android:textSize="@dimen/player_time_text_size" />
        </LinearLayout>

        <!-- Function Row -->
        <HorizontalScrollView
            android:id="@+id/playerFunctionRow"
            android:layout_width="match_parent"
            android:layout_height="@dimen/player_function_row_height"
            android:layout_marginTop="@dimen/player_function_row_margin_top"
            android:scrollbars="none"
            android:fadingEdgeLength="16dp"
            android:requiresFadingEdge="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/playerLockButton"
                    android:layout_width="@dimen/player_function_button_size"
                    android:layout_height="@dimen/player_function_button_size"
                    android:layout_marginEnd="@dimen/player_function_button_spacing"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/player_lock_content_description"
                    android:padding="@dimen/player_function_button_padding"
                    app:srcCompat="@drawable/ic_player_lock" />

                <ImageButton
                    android:id="@+id/playerSubtitleButton"
                    android:layout_width="@dimen/player_function_button_size"
                    android:layout_height="@dimen/player_function_button_size"
                    android:layout_marginEnd="@dimen/player_function_button_spacing"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/player_subtitle_content_description"
                    android:padding="@dimen/player_function_button_padding"
                    app:srcCompat="@drawable/ic_player_subtitle" />

                <ImageButton
                    android:id="@+id/playerResizeButton"
                    android:layout_width="@dimen/player_function_button_size"
                    android:layout_height="@dimen/player_function_button_size"
                    android:layout_marginEnd="@dimen/player_function_button_spacing"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/player_resize_content_description"
                    android:padding="@dimen/player_function_button_padding"
                    app:srcCompat="@drawable/ic_player_resize_fit" />

                <ImageButton
                    android:id="@+id/playerRotateButton"
                    android:layout_width="@dimen/player_function_button_size"
                    android:layout_height="@dimen/player_function_button_size"
                    android:layout_marginEnd="@dimen/player_function_button_spacing"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/player_rotate_content_description"
                    android:padding="@dimen/player_function_button_padding"
                    app:srcCompat="@drawable/ic_player_rotate" />

                <ImageButton
                    android:id="@+id/playerAudioTrackButton"
                    android:layout_width="@dimen/player_function_button_size"
                    android:layout_height="@dimen/player_function_button_size"
                    android:layout_marginEnd="@dimen/player_function_button_spacing"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/player_audio_track_content_description"
                    android:padding="@dimen/player_function_button_padding"
                    app:srcCompat="@drawable/ic_player_track_selector" />

                <Spinner
                    android:id="@+id/playerSpeedSpinner"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/player_function_button_size"
                    android:layout_marginEnd="@dimen/player_function_button_spacing"
                    android:contentDescription="@string/player_speed_content_description" />

                <ImageButton
                    android:id="@+id/playerShuffleButton"
                    android:layout_width="@dimen/player_function_button_size"
                    android:layout_height="@dimen/player_function_button_size"
                    android:layout_marginEnd="@dimen/player_function_button_spacing"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/player_shuffle_content_description"
                    android:padding="@dimen/player_function_button_padding"
                    app:srcCompat="@drawable/ic_player_shuffle" />

                <ImageButton
                    android:id="@+id/playerAutoPlayButton"
                    android:layout_width="@dimen/player_function_button_size"
                    android:layout_height="@dimen/player_function_button_size"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/player_autoplay_content_description"
                    android:padding="@dimen/player_function_button_padding"
                    app:srcCompat="@drawable/ic_player_autoplay" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Transport Row -->
        <LinearLayout
            android:id="@+id/playerTransportRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/player_transport_row_margin_top"
            android:gravity="center"
            android:minHeight="@dimen/player_transport_row_min_height"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/playerSkipPreviousButton"
                android:layout_width="@dimen/player_transport_button_size"
                android:layout_height="@dimen/player_transport_button_size"
                android:layout_marginStart="@dimen/player_transport_button_spacing"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_skip_previous_content_description"
                android:padding="@dimen/player_transport_button_padding"
                app:srcCompat="@drawable/ic_player_skip_previous" />

            <ImageButton
                android:id="@+id/playerSeekBackButton"
                android:layout_width="@dimen/player_transport_button_size"
                android:layout_height="@dimen/player_transport_button_size"
                android:layout_marginStart="@dimen/player_transport_button_spacing"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_seek_back_content_description"
                android:padding="@dimen/player_transport_button_padding"
                app:srcCompat="@drawable/ic_player_seek_back" />

            <ImageButton
                android:id="@+id/playerPlayPauseButton"
                android:layout_width="@dimen/player_transport_primary_button_size"
                android:layout_height="@dimen/player_transport_primary_button_size"
                android:layout_marginStart="@dimen/player_transport_button_spacing"
                android:layout_marginEnd="@dimen/player_transport_button_spacing"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_play_content_description"
                android:padding="@dimen/player_transport_primary_button_padding"
                app:srcCompat="@drawable/ic_player_play" />

            <ImageButton
                android:id="@+id/playerSeekForwardButton"
                android:layout_width="@dimen/player_transport_button_size"
                android:layout_height="@dimen/player_transport_button_size"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_seek_forward_content_description"
                android:padding="@dimen/player_transport_button_padding"
                app:srcCompat="@drawable/ic_player_seek_forward" />

            <ImageButton
                android:id="@+id/playerSkipNextButton"
                android:layout_width="@dimen/player_transport_button_size"
                android:layout_height="@dimen/player_transport_button_size"
                android:layout_marginStart="@dimen/player_transport_button_spacing"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_skip_next_content_description"
                android:padding="@dimen/player_transport_button_padding"
                app:srcCompat="@drawable/ic_player_skip_next" />

            <ImageButton
                android:id="@+id/playerRepeatButton"
                android:layout_width="@dimen/player_transport_button_size"
                android:layout_height="@dimen/player_transport_button_size"
                android:layout_marginStart="@dimen/player_transport_button_spacing"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_repeat_content_description"
                android:padding="@dimen/player_transport_button_padding"
                app:srcCompat="@drawable/ic_player_repeat_off" />

            <ImageButton
                android:id="@+id/playerTrackSelectorButton"
                android:layout_width="@dimen/player_transport_button_size"
                android:layout_height="@dimen/player_transport_button_size"
                android:layout_marginStart="@dimen/player_transport_button_spacing"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_track_selector_content_description"
                android:padding="@dimen/player_transport_button_padding"
                app:srcCompat="@drawable/ic_player_track_selector" />
        </LinearLayout>
    </LinearLayout>

    <!-- Unlock button (visible only in locked state) -->
    <ImageButton
        android:id="@+id/playerUnlockButton"
        android:layout_width="@dimen/player_transport_primary_button_size"
        android:layout_height="@dimen/player_transport_primary_button_size"
        android:layout_gravity="center"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/player_unlock_content_description"
        android:padding="@dimen/player_transport_primary_button_padding"
        android:visibility="gone"
        app:srcCompat="@drawable/ic_player_unlock" />
</FrameLayout>
